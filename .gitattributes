# Normalize line endings to LF in the repository across platforms.
# Keeps husky shell hooks and tooling stable on Windows clones (no CRLF).
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
