  "cards": [
    {
      "dot": "cyan",
      "title": "The direction is INBOUND",
      "items": [
        "MCPwn hosts the per-run MCP endpoint; the agent connects to it.",
        "Every tools/call is the agent OWN decision, with its arguments: that is the signal red-teaming needs.",
        "You cannot poison a tool surface you do not serve, so ASI01/02/04/05/06 are only stageable from this side.",
        "taskGoal is delivered OUT OF BAND: a published MCP prompt, or paste.",
        "agent_reasoning is NOT observable from the server side and is never synthesized."
      ]
    },
    {
      "dot": "rose",
      "title": "Credentials, both directions",
      "items": [
        "We never call your agent, so we hold no key of yours.",
        "We authenticate the INCOMING connection with a per-run, per-account token.",
        "The token is scoped to one run and expires with it.",
        "The endpoint is hostile by design, with nothing real behind it."
      ]
    },
    {
      "dot": "amber",
      "title": "Drawn as specified, not as shipped",
      "items": [
        "Tagged 'not built yet': the hosted endpoint and module 8.",
        "Modules 1, 3, 4b, 5 and 6 exist in src/ but nothing in the app calls them yet.",
        "The deployed UI reads curated fixtures through the DataSource port.",
        "build(variant) also yields the observable fixture Trace; only the label side is drawn here."
      ]
    },
    {
      "dot": "slate",
      "title": "McpTargetPort keeps a narrower job",
      "items": [
        "Probing a target MCP server: the ASI02 and ASI05 surfaces.",
        "Supplying the shared transport, JSON-RPC, Zod and retry layer.",
        "It is not the live agent path and is not documented as one."
      ]
    }
  ]
