# ─────────────────────────────────────────────────────────────────────────────
# MCPwn — environment configuration (12-Factor III: config in the environment)
#
# HOW TO USE
#   Copy this file to `.env.local` (gitignored) and set values as needed.
#   NEVER commit real secrets. This template contains PLACEHOLDERS only.
#
# CONFIG SPLIT (offline-safe core vs deferred adapter creds)
#   The app boots OFFLINE with none of the deferred adapter creds set. For local
#   dev you only need the CORE vars below; with PERSISTENCE_DRIVER=memory the
#   walking skeleton builds, boots, and passes tests with zero external creds.
#
#   • CORE            — required to boot (NODE_ENV, PERSISTENCE_DRIVER).
#   • PERSISTENCE     — DATABASE_URL, only when PERSISTENCE_DRIVER=postgres;
#                       validated lazily at repository-adapter construction.
#   • DEFERRED PORTS  — JudgeModelPort + McpTargetPort creds. Their HTTP adapters
#                       validate their own creds LAZILY, so an empty value is fine
#                       until the live wave (Phase 8). The live judge is gated.
#
#   Offline deploy (Vercel, no creds):  NODE_ENV=production  PERSISTENCE_DRIVER=memory
# ─────────────────────────────────────────────────────────────────────────────

# ── CORE · required to boot (offline-safe) ──

# Node environment. One of: development | test | production
NODE_ENV=development

# Persistence adapter behind the repository port. One of: memory | postgres
#   memory   = in-memory adapter (default; local dev / tests / offline deploy). No DATABASE_URL needed.
#   postgres = Postgres adapter (later phase; Supabase Postgres in prod — the
#              adapter is provider-agnostic, any Postgres via DATABASE_URL below).
PERSISTENCE_DRIVER=memory

# ── PERSISTENCE · required only when PERSISTENCE_DRIVER=postgres ──

# Postgres connection string (a valid postgres:// URL) — Supabase Postgres in prod.
# Validated LAZILY when the Postgres adapter is constructed; leave empty for the
# in-memory driver. SECRET — never commit a real value.
# Supabase: use the connection-pooler URL from Project Settings → Database.
# Example shape: postgres://<user>:<password>@<host>:<port>/<db>?sslmode=require
DATABASE_URL=

# ── Supabase Auth (gates live runs) ──
# Sign-in by emailed one-time code, no clickable link (+ GitHub OAuth). Config is
# env-only; leave empty for
# an offline boot — auth stays INERT and sample playback needs no auth. Presence
# is keyed on NEXT_PUBLIC_SUPABASE_URL (see getSupabaseConfig).

# Supabase project URL. PUBLIC. The NEXT_PUBLIC_ prefix is REQUIRED so the browser
# auth client can read it.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. PUBLIC (client-safe; RLS-scoped). NEXT_PUBLIC_ required.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET — SERVER-ONLY (no NEXT_PUBLIC_ prefix), never
# exposed to the client, never logged, never persisted in plaintext. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── DEFERRED · Detector JudgeModelPort (blind LLM alignment-auditor) ──
# Validated lazily when the HTTP judge adapter is built (live wave, Phase 8).
# Leave empty for an offline boot; the live judge is gated.

# Pinned judge model id (determinism — one fixed model).
JUDGE_MODEL=

# Base URL of the OpenAI-compatible model gateway the detector calls.
JUDGE_BASE_URL=

# API key for the judge gateway. SECRET — never commit a real value.
JUDGE_API_KEY=

# Judge sampling temperature. Keep low for determinism (e.g. 0).
JUDGE_TEMPERATURE=0

# ── DEFERRED · McpTargetPort (target MCP agent under test) ──
# Validated lazily when the MCP target adapter is built (live wave, Phase 8).
# Leave empty for an offline boot.

# The MCP endpoint the harness connects to and instruments.
MCP_TARGET_URL=

# Bearer token / credential for the MCP target, if it requires one.
# SECRET — never commit a real value.
MCP_TARGET_TOKEN=
