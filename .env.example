# ─────────────────────────────────────────────────────────────────────────────
# MCPwn — environment configuration (12-Factor III: config in the environment)
#
# HOW TO USE
#   Copy this file to `.env.local` (gitignored) and set values as needed.
#   NEVER commit real secrets. This template contains PLACEHOLDERS only.
#
# CONFIG SPLIT (offline-safe core vs deferred adapter creds)
#   The app boots OFFLINE with none of the deferred adapter creds set. For local
#   dev you only need the CORE vars below; with PERSISTENCE_DRIVER=memory the
#   walking skeleton builds, boots, and passes tests with zero external creds.
#
#   • CORE            — required to boot (NODE_ENV, PERSISTENCE_DRIVER).
#   • PERSISTENCE     — DATABASE_URL, only when PERSISTENCE_DRIVER=postgres;
#                       validated lazily at repository-adapter construction.
#   • DEFERRED PORTS  — JudgeModelPort + McpTargetPort creds. Their HTTP adapters
#                       validate their own creds LAZILY, so an empty value is fine
#                       until the live wave (Phase 8). The live judge is gated.
#
#   Offline deploy (Vercel, no creds):  NODE_ENV=production  PERSISTENCE_DRIVER=memory
# ─────────────────────────────────────────────────────────────────────────────

# ── CORE · required to boot (offline-safe) ──

# Node environment. One of: development | test | production
NODE_ENV=development

# Persistence adapter behind the repository port. One of: memory | postgres
#   memory   = in-memory adapter (default; local dev / tests / offline deploy). No DATABASE_URL needed.
#   postgres = Postgres adapter (later phase; Supabase Postgres in prod — the
#              adapter is provider-agnostic, any Postgres via DATABASE_URL below).
PERSISTENCE_DRIVER=memory

# Canonical public origin. OPTIONAL — defaults to https://mcpwn.dev. This is the
# `metadataBase` every RELATIVE metadata URL (Open Graph, canonical, images)
# resolves against; with no base Next falls back to http://localhost:3000, so a
# deployed page would advertise localhost URLs. Set it only to point a non-prod
# deployment at its own origin. Normalized to the bare origin (a trailing slash
# or path is dropped); a set-but-malformed value is a hard ConfigError.
#   Example: https://staging.mcpwn.dev
NEXT_PUBLIC_SITE_URL=

# ── PERSISTENCE · required only when PERSISTENCE_DRIVER=postgres ──

# Postgres connection string (a valid postgres:// URL) — Supabase Postgres in prod.
# Validated LAZILY when the Postgres adapter is constructed; leave empty for the
# in-memory driver. SECRET — never commit a real value.
# Supabase: use the connection-pooler URL from Project Settings → Database.
# Example shape: postgres://<user>:<password>@<host>:<port>/<db>?sslmode=require
DATABASE_URL=

# ── Supabase Auth (gates live runs) ──
# Sign-in by emailed one-time code, no clickable link (+ GitHub OAuth). Config is
# env-only; leave empty for
# an offline boot — auth stays INERT and sample playback needs no auth. Presence
# is keyed on NEXT_PUBLIC_SUPABASE_URL (see getSupabaseConfig).

# Supabase project URL. PUBLIC. The NEXT_PUBLIC_ prefix is REQUIRED so the browser
# auth client can read it.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. PUBLIC (client-safe; RLS-scoped). NEXT_PUBLIC_ required.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Digits in an emailed sign-in code. MUST equal the live project's
# Authentication -> Email OTP Length setting (Supabase allows 6 to 10).
# PUBLIC: the sign-in copy, the placeholder and the accepted length all derive
# from this one value, so a wrong number makes the copy untrue AND makes the form
# refuse every real code. The gated tests/integration/otp-length.live.test.ts
# proves it against the real project. Leave unset to take the default.
NEXT_PUBLIC_EMAIL_OTP_LENGTH=

# Supabase service-role key. SECRET — SERVER-ONLY (no NEXT_PUBLIC_ prefix), never
# exposed to the client, never logged, never persisted in plaintext. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Live-run cost control (ADR-0007) ──

# Free live runs per account, for the account's whole LIFETIME (a total, not a
# rate — an exhausted account does not refill tomorrow). Counted from account
# creation by src/runs/allowance.ts. Leave unset to take the default of 3.
#
# A TUNABLE DEFAULT, not a product promise: move it as observed judge cost
# changes. 0 turns free live runs off. SERVER-ONLY on purpose (no NEXT_PUBLIC_):
# the browser never decides how much the operator spends. Every human-visible
# mention DERIVES from this value (describeLiveRunAllowance) — never hardcode the
# numeral into copy. An out-of-range or non-integer value is a hard ConfigError,
# because a spend control that silently falls back is not a spend control.
LIVE_RUN_ALLOWANCE=

# ── DEFERRED · Detector JudgeModelPort (blind LLM alignment-auditor) ──
# Read by resolveLiveDetector(), which builds the HTTP judge adapter against the
# ANTHROPIC MESSAGES API (POST {JUDGE_BASE_URL}/v1/messages, x-api-key header).
# Leave empty for an offline boot: with no key the live detector resolves to null
# and live detection is simply unavailable — sample playback needs none of this.
# A key set WITHOUT a model or base URL is a real error, not silent inertness.

# Pinned judge model id (determinism — one fixed, validated model).
#
# It MUST be a model that still accepts the `temperature` parameter, because a
# pinned low temperature is part of what makes a measured P/R reproducible.
# Anthropic removed the sampling parameters on the Claude 4.7+ and 5 families,
# which reject `temperature` with a 400. `claude-haiku-4-5` is the intended cheap
# validated judge (ADR-0007 puts operator cost at a few cents per run).
JUDGE_MODEL=

# API origin the judge adapter calls. Normalized to its bare origin, so a
# trailing slash or path is harmless. For the Anthropic API: https://api.anthropic.com
JUDGE_BASE_URL=

# The judge credential, sent as `x-api-key`. SECRET — never commit a real value,
# never logged, never interpolated into an error message.
JUDGE_API_KEY=

# Judge sampling temperature. Keep low for determinism (e.g. 0).
JUDGE_TEMPERATURE=0

# ── DEFERRED · McpTargetPort (target MCP agent under test) ──
# Validated lazily when the MCP target adapter is built (live wave, Phase 8).
# Leave empty for an offline boot.

# The MCP endpoint the harness connects to and instruments.
MCP_TARGET_URL=

# Bearer token / credential for the MCP target, if it requires one.
# SECRET — never commit a real value.
MCP_TARGET_TOKEN=
